# Current lifecycle: deeep.ts + deeep/runtime.ts. Connector A repeats the scheduler tick.
direction: down
classes: {
  human: {style.fill: "#FEF3C7"; style.stroke: "#B45309"}
  model: {style.fill: "#DCFCE7"; style.stroke: "#15803D"}
  script: {style.fill: "#DBEAFE"; style.stroke: "#1D4ED8"}
  decision: {shape: diamond; style.fill: "#DBEAFE"}
  paused: {style.fill: "#FEE2E2"; style.stroke: "#B91C1C"}
}
planning: "1. Plan and approve" {
  style.fill: "#F8FAFC"
  request: "USER\n/deeep <description>" {class: human}
  architect: "MAIN MODEL\nExplore; clarify requirements\nWrite specs.md: atomic tasks, models, dependencies" {class: model}
  approval: "USER\nReview / edit specs.md\n/deeep go" {class: human}
  request -> architect -> approval
}
execution: "2. Scripted execution and recovery" {
  style.fill: "#F8FAFC"
  recover: "SCRIPT: /deeep go\nAcquire exclusive repository lock; validate plan\nReconcile persisted task stages and worker receipts\nRetain files, commits, PRs and saved merge gate" {class: script}
  saved_gate: "Saved merge gate\nstill pending?" {class: decision}
  tick: "A — SCRIPT: scheduler tick\nFetch origin/main; verify completed-task merges\nRead fresh task checkpoints" {class: script}
  ready: "Any pending tasks\nwith all dependencies\ndone AND merged?" {class: decision}
  batch: "SCRIPT: run eligible batch\nUp to DEEEEP_MAX_PARALLEL tasks (default 2)\nResume each task from its saved stage\nWait for batch outcomes; persist them" {class: script; link: deeep-task.svg}
  unmerged: "Any done tasks\nstill unmerged?" {class: decision}
  save_gate: "SCRIPT\nPersist exact pending merge task ids" {class: script}
  prompt: "USER PROMPT\nReview and merge listed branches / PRs into main\nYes = verify; No / Esc = pause" {class: human}
  verify: "SCRIPT\nFetch origin/main; check git ancestry / GitHub PR state\nNever accept Yes as evidence of merging" {class: script}
  pending: "Any branches still\nunmerged or unverified?" {class: decision}
  clear_gate: "SCRIPT\nClear saved merge gate" {class: script}
  again: "A — Repeat scheduler tick" {shape: oval; class: script}
  terminal: "All tasks done\nand all merged?" {class: decision}
  complete: "COMPLETE" {class: script}
  pause: "PAUSED / BLOCKED\nKeep checkpoints and partial work\n/deeep go retries or resumes the correct stage" {class: paused}

  recover -> saved_gate
  saved_gate -> prompt: yes (reconcile offline merges first)
  saved_gate -> tick: no
  tick -> ready
  ready -> batch: yes
  batch -> again
  ready -> unmerged: no
  unmerged -> save_gate: yes
  save_gate -> prompt
  prompt -> verify: Yes
  prompt -> pause: No / Esc / UI unavailable
  verify -> pending
  pending -> prompt: yes — list remaining branches only
  pending -> clear_gate: no
  clear_gate -> again
  unmerged -> terminal: no
  terminal -> complete: yes
  terminal -> pause: no — failures / unresolved dependencies
}
planning.approval -> execution.recover

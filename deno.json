{
  "tasks": {
    "dev:web": "deno run -A npm:vite",
    "build:web": "deno run -A npm:vite build",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute DB --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute DB --remote --file=./migrations/0001_init.sql",
    "check": "deno check worker/ web/src/",
    "test": "deno test -A worker/"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "es2023", "dom", "dom.iterable"],
    "strict": true
  }
}
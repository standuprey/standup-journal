{
  "name": "standup-journal",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "standup-journal-db",
      "database_id": "REPLACE_ME",
      "migrations_dir": "migrations"
    }
  ]
}